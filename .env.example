# Public site origin. Used only by the dashboard, to preview images stored
# as site-relative paths (e.g. /images/blog/cover.png).
VITE_SITE_URL=https://emon69.netlify.app

# Backend API. Defaults to the deployed one; point at a local server in dev.
# VITE_API_URL=http://localhost:5000/api/v1

# Cloudinary image uploads. Both values are public by design — an unsigned
# preset is meant to be called from the browser. Lock the preset down in the
# Cloudinary console (folder, formats, max size) instead of hiding the name.
# Without these the dashboard still works; the upload box just explains
# it isn't configured and you paste URLs instead.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
